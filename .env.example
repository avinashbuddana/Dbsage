NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=schemaiq
DATABASE_USER=schemaiq
DATABASE_PASSWORD=change-me-for-local-development
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-for-local-development

JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DATASOURCE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MYSQL_MAX_ACTIVE_DATASOURCES=10
MYSQL_DATASOURCE_IDLE_TIMEOUT_MS=300000
MYSQL_DATASOURCE_CLEANUP_INTERVAL_MS=60000
MYSQL_POOL_SIZE=3
MYSQL_CONNECT_TIMEOUT_MS=5000
ALLOW_LOCAL_DATASOURCES=false

MYSQL_TEST_PORT=3307
MYSQL_TEST_DATABASE=schemaiq_customer
MYSQL_TEST_USER=schemaiq_reader
MYSQL_TEST_PASSWORD=change-me-for-local-development
MYSQL_TEST_ROOT_PASSWORD=change-me-for-local-development-root
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
