# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Internal SchemaIQ PostgreSQL only. Never use these values for customer databases.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=schemaiq
DATABASE_USER=schemaiq
DATABASE_PASSWORD=change-me-for-local-development
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-for-local-development

# Application secrets and datasource credential encryption
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DATASOURCE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Customer connection manager tuning only. These are never customer credentials.
MYSQL_MAX_ACTIVE_DATASOURCES=10
MYSQL_DATASOURCE_IDLE_TIMEOUT_MS=300000
MYSQL_DATASOURCE_CLEANUP_INTERVAL_MS=60000
MYSQL_CUSTOMER_POOL_SIZE=3
MYSQL_CONNECT_TIMEOUT_MS=5000
ALLOW_LOCAL_DATASOURCES=false

# PostgreSQL CSV import processing
CSV_IMPORT_MAX_FILE_SIZE_BYTES=1073741824
CSV_IMPORT_SYNC_MAX_FILE_SIZE_BYTES=5242880
CSV_IMPORT_QUEUE_THRESHOLD_BYTES=5242880
CSV_IMPORT_MAX_COLUMNS=200
CSV_IMPORT_MAX_HEADER_LENGTH=256
# A character set, not a comma-delimited list. This allows comma, semicolon, and pipe.
CSV_IMPORT_ALLOWED_DELIMITERS=,;|
CSV_IMPORT_TEMP_DIR=/tmp/schemaiq-imports
CSV_IMPORT_WORKER_CONCURRENCY=2
CSV_IMPORT_MAX_ACTIVE_JOBS=100
CSV_IMPORT_JOB_TIMEOUT_MS=1800000
CSV_IMPORT_RETENTION_HOURS=24
CSV_IMPORT_CLEANUP_INTERVAL_MS=3600000
CSV_IMPORT_POSTGRES_POOL_MAX=3

# LLM gateway. Keep OPENROUTER_API_KEY in secret management; never expose it to clients.
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Set false for endpoints without response_format support; structured calls then use forced tool arguments.
OPENROUTER_SUPPORTS_JSON_SCHEMA=false
LLM_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# Comma-separated OpenRouter fallbacks. Sonnet may incur provider charges when it is used.
LLM_FALLBACK_MODELS=anthropic/claude-sonnet-5
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# Local development uses Ollama first. Install it, then run: ollama pull llama3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_MS=120000

# Embeddings stay separate from chat models. Pull a real embedding model, for example:
# ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_TIMEOUT_MS=120000
KNOWLEDGE_AUTO_REFRESH_ON_SCHEMA_CHANGE=false

# Bounded hybrid context retrieval. Context uses persisted schema snapshots first,
# then the current verified knowledge version only when it matches that snapshot.
DATABASE_CONTEXT_MAX_RELATIONSHIP_DEPTH=1
DATABASE_CONTEXT_MAX_ITEMS=30
DATABASE_CONTEXT_MAX_ESTIMATED_TOKENS=1000
DATABASE_CONTEXT_MAX_TABLES=8
DATABASE_CONTEXT_MAX_COLUMNS_PER_TABLE=12
DATABASE_CONTEXT_MAX_RELATIONSHIPS=16
DATABASE_CONTEXT_MAX_FINDINGS=10
DATABASE_CONTEXT_MAX_KNOWLEDGE=16
DATABASE_CONTEXT_MIN_VECTOR_SIMILARITY=0.45

# SQL generation only: no generated query is ever executed in this milestone.
SQL_MAX_TABLES=4
SQL_MAX_JOINS=3
SQL_MAX_SUBQUERY_DEPTH=0
SQL_MAX_FILTER_DEPTH=3
SQL_MAX_GROUP_BY_COLUMNS=5
SQL_MAX_ORDER_BY_COLUMNS=5
SQL_MAX_LIMIT=1000
SQL_DEFAULT_LIMIT=100
SQL_MAX_OFFSET=10000
SQL_ALLOW_CTES=false
SQL_ALLOW_DISTINCT=true

# Integration-test MySQL fixture only. Production services never read these values.
INTEGRATION_MYSQL_PORT=3307
INTEGRATION_MYSQL_DATABASE=schemaiq_customer
INTEGRATION_MYSQL_USERNAME=schemaiq_reader
INTEGRATION_MYSQL_PASSWORD=change-me-for-local-development
INTEGRATION_MYSQL_ROOT_PASSWORD=change-me-for-local-development-root
