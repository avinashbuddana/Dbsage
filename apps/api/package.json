{
  "name": "@schemaiq/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @schemaiq/shared build && pnpm --filter @schemaiq/types build",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/typeorm.datasource.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/typeorm.datasource.ts --transaction each",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/typeorm.datasource.ts --transaction each",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/typeorm.datasource.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@schemaiq/shared": "workspace:*",
    "@schemaiq/types": "workspace:*",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "nestjs-pino": "^4.4.1",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2": "^1.17.0",
    "typeorm": "^0.3.31",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2"
  }
}
